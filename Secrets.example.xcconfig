// Copy to Secrets.xcconfig and keep that file out of git.
// Then wire these values into your local build settings if needed.

VAULTE_RELAY_BASE_URL = https://your-relay.example.com
VAULTE_RELAY_API_KEY =
VAULTE_RELAY_HMAC_SECRET =
VAULTE_RELAY_USERNAME_LOOKUP_PEPPER =

// TLS certificate public key pinning (SPKI SHA-256, base64).
// Comma-separate multiple hashes for backup pins / key rotation.
// Generate: openssl s_client -connect <host>:443 </dev/null 2>/dev/null \
//   | openssl x509 -pubkey -noout \
//   | openssl pkey -pubin -outform der \
//   | openssl dgst -sha256 -binary | base64
// Leave empty to skip pinning (development only).
VAULTE_PINNED_KEY_HASHES =

